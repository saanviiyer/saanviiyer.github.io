528 0 obj
<<
/Type /StructElem
/S /P
/ActualText (Dr. Jocelyn Bell Burnell - Astrophysicist and aerospace engineer, credited with the discovery of pulsars.)
/Pg 16 0 R
/K [5]
>>
endobj
529 0 obj
<<
/Type /StructElem
